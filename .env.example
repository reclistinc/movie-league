# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# TMDb → Settings → API. Set ONE of these (server-only, never exposed to the browser).
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Optional: GIPHY → developers.giphy.com → Create an App → API. Enables "Add a GIF" on picks.
GIPHY_API_KEY=
